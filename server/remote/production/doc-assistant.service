[Unit]
Description=Doc-Assistant API Server
After=network.target

[Service]
Type=simple
User=docassistant
WorkingDirectory=/var/www/doc-assistant
# Start the Node.js application
ExecStart=/usr/bin/node /var/www/doc-assistant/cmd/api/index.js
# Automatically restart if it crashes
Restart=on-failure
RestartSec=5
# Load environment variables
EnvironmentFile=/var/www/doc-assistant/.env

[Install]
WantedBy=multi-user.target