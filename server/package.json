{
  "name": "doc-assistant-server",
  "version": "1.0.0",
  "description": "Server for doc assistant - a RAG based project",
  "keywords": [
    "node.js",
    "RAG",
    "DocAssistant",
    "express.js"
  ],
  "license": "ISC",
  "author": "sohail",
  "type": "commonjs",
  "main": "./cmd/api/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",

    "// --- DEVELOPMENT ---": "",
    "dev": "nodemon ./cmd/api/index.js --env=development --port=8080",
    "start": "node ./cmd/api/index.js",

    "// --- PRODUCTION CONNECTION ---": "",
    "production:connect": "ssh docassistant-prod",

    "// --- DATABASE SCRIPTS ---": "",
    "db:generate": "npx drizzle-kit generate",
    "db:push": "npx drizzle-kit push",

    "// --- DEPLOYMENT SCRIPTS ---": "",
    "deploy:api": "npm run deploy:sync && npm run deploy:install && npm run deploy:restart",
    "deploy:sync": "rsync -rP --delete --exclude='node_modules' --exclude='.env' --exclude='.git' --exclude='uploads' ./ docassistant-prod:/var/www/doc-assistant",
    "deploy:install": "ssh -t docassistant-prod 'cd /var/www/doc-assistant && npm install --omit=dev'",
    "deploy:restart": "ssh -t docassistant-prod 'sudo systemctl restart doc-assistant'",
    
    "// --- CONFIGURE INFRASTRUCTURE ---": "",
    "configure:service": "rsync -P ./remote/production/doc-assistant.service docassistant-prod:~ && ssh -t docassistant-prod 'sudo mv ~/doc-assistant.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable doc-assistant && sudo systemctl restart doc-assistant'",
    "configure:caddy": "rsync -P ./remote/production/Caddyfile docassistant-prod:~ && ssh -t docassistant-prod 'sudo mv ~/Caddyfile /etc/caddy/ && sudo systemctl reload caddy'"
  },
  "dependencies": {
    "@clerk/express": "^1.7.69",
    "@google/genai": "^1.41.0",
    "@langchain/community": "^1.1.19",
    "@langchain/core": "^1.1.30",
    "@langchain/google-genai": "^2.1.20",
    "@langchain/textsplitters": "^1.0.1",
    "@neondatabase/serverless": "^1.0.2",
    "bullmq": "^5.70.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.10.0",
    "multer": "^2.0.2",
    "nodemon": "^3.1.14",
    "pdf-parse": "^1.1.4",
    "uuid": "^13.0.0"
  },
  "overrides": {
    "@langchain/community": {
      "pdf-parse": "$pdf-parse"
    }
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.9"
  }
}
